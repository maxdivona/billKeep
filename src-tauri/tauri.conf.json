{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "billkeep",
  "version": "1.1.0",
  "identifier": "com.billkeep.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite-dev",
    "beforeBuildCommand": "npm run vite-build"
  },
  "app": {
    "windows": [
      {
        "title": "BillKeep",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
